generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/** What kind of actor this is (a Maison, a group, an agency…). */
enum CompanyKind {
  UNKNOWN
  MAISON
  GROUP
  RETAILER
  AGENCY
  RECRUITER
  MEDIA
  SUPPLIER
  OTHER
}

/**
 * Which segment of the vertical the employer belongs to.
 *
 * Distinct from CompanyKind on purpose: Cartier is a MAISON *and*
 * JEWELRY_WATCHES, and the front end filters on the segment. Reusing `kind` for
 * both would force one to be wrong.
 */
enum CompanySector {
  UNKNOWN
  FASHION
  LUXURY
  BEAUTY
  JEWELRY_WATCHES
  RETAIL
  SUPPLIER
  MEDIA_AGENCY
  RECRUITER
  OTHER
}

enum DiscoveryStatus {
  PENDING
  FOUND
  NEEDS_REVIEW
  UNSUPPORTED
  ERROR
}

enum AtsType {
  MAGNET
  TALENTVIEW
  EIGHTFOLD
  AVATURE
  TEAMTAILOR
  DIGITALRECRUITERS
  PHENOM
  SUCCESSFACTORS
  WTTJ
  ASHBY
  WORKABLE
  GREENHOUSE
  LEVER
  SMARTRECRUITERS
  RECRUITEE
  PERSONIO
  WORKDAY
  GENERIC_JSONLD
  UNKNOWN
}

model Company {
  id                   String          @id @default(cuid())
  name                 String
  canonicalKey         String
  kind                 CompanyKind     @default(UNKNOWN)
  sector               CompanySector   @default(UNKNOWN)
  fashionjobsUrl       String          @unique
  fashionjobsSlug      String?
  fashionjobsOfferCount Int?
  careersUrl           String?
  atsType               AtsType         @default(UNKNOWN)
  atsConfig             Json?
  discoveryStatus       DiscoveryStatus @default(PENDING)
  discoveryNote         String?
  firstSeenAt           DateTime        @default(now())
  lastSeenAt            DateTime        @default(now())
  lastAtsDiscoveryAt    DateTime?
  lastJobSyncAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  jobs                  Job[]
  aliases               CompanyAlias[]

  @@index([sector])
  @@index([canonicalKey])
  @@index([discoveryStatus])
  @@index([atsType])
}

model CompanyAlias {
  id          String   @id @default(cuid())
  aliasKey    String   @unique
  displayName String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

/**
 * Where a canonical Job was seen. One row per (job, source).
 *
 * This is the whole point of the aggregator: the same opening reaches us from the
 * Maison's careers site, the group portal and a jobboard, and Catwalks keeps ONE
 * Job carrying N JobSource rows — never three listings.
 *
 * A lower-priority source stays attached even when it is not canonical: it is what
 * detects an edit or a closure when the canonical source is slow to update.
 */
model JobSource {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** Registry key: 'richemont', 'wttj', 'fashionjobs'… */
  sourceKey   String
  /** EMPLOYER_DIRECT | GROUP_OFFICIAL | ATS_OFFICIAL | SPECIALIST_JOBBOARD | AGGREGATOR */
  sourceTier  String
  /** Identifier as this source knows it. */
  externalId  String
  /** Apply URL at THIS source; the canonical one lives on Job.url. */
  url         String
  title       String?
  postedAt    DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)
  raw         Json?

  @@unique([sourceKey, externalId])
  @@index([jobId])
  @@index([sourceKey, isActive])
}

model Job {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId    String
  source        AtsType
  title         String
  location      String?
  country       String?
  isFrance      Boolean  @default(false)

  // Geo, for the Leaflet map. Sources give a city and usually a postcode but
  // never coordinates, so these are resolved via the French government's
  // Adresse API (api-adresse.data.gouv.fr — free, no key, 50 req/s/IP).
  city          String?
  postalCode    String?
  /** INSEE commune code: a stable join key, unlike a city name. */
  inseeCode     String?
  latitude      Float?
  longitude     Float?

  contract      String?
  description   String?
  url           String
  postedAt      DateTime?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  isActive      Boolean  @default(true)
  fingerprint   String

  /**
   * Blocking key of the dedup cluster: resolvedCompanyId|CITY.
   * Indexed because every write does a cluster lookup before inserting — that
   * lookup is what keeps duplicates out of the database in the first place,
   * rather than cleaning them up afterwards.
   */
  clusterKey    String?
  /** Tier of the source that owns Job.url, so a better source can take over. */
  canonicalTier String?

  sources       JobSource[]

  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, source, externalId])
  @@index([clusterKey])
  @@index([isFrance, isActive])
  @@index([fingerprint])
  @@index([companyId, isActive])
  // Serves the map: only located, live French jobs are ever plotted.
  @@index([isFrance, isActive, latitude, longitude])
}

/**
 * Geocoding cache, keyed by the raw location string as a source wrote it.
 *
 * Cities repeat constantly across offers — Courir alone posts dozens of roles in
 * the same towns — so resolving per offer would waste tens of thousands of calls
 * on a handful of distinct places. `resolved = false` records a lookup that found
 * nothing, so a bad string is not retried on every run.
 */
model GeoCache {
  id          String   @id @default(cuid())
  /** Normalized lookup key (uppercase city, plus postcode when available). */
  queryKey    String   @unique
  city        String?
  postalCode  String?
  inseeCode   String?
  latitude    Float?
  longitude   Float?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resolved])
}
