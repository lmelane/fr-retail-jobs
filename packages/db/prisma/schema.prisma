generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/** What kind of actor this is (a Maison, a group, an agency…). */
enum CompanyKind {
  UNKNOWN
  MAISON
  GROUP
  RETAILER
  AGENCY
  RECRUITER
  MEDIA
  SUPPLIER
  OTHER
}

/**
 * Which segment of the vertical the employer belongs to.
 *
 * Distinct from CompanyKind on purpose: Cartier is a MAISON *and*
 * JEWELRY_WATCHES, and the front end filters on the segment. Reusing `kind` for
 * both would force one to be wrong.
 */
enum CompanySector {
  UNKNOWN
  FASHION
  LUXURY
  BEAUTY
  JEWELRY_WATCHES
  RETAIL
  SUPPLIER
  MEDIA_AGENCY
  RECRUITER
  OTHER
}

enum DiscoveryStatus {
  PENDING
  FOUND
  NEEDS_REVIEW
  UNSUPPORTED
  ERROR
}

enum AtsType {
  PINPOINT
  LVMH_ALGOLIA
  MAGNET
  TALENTVIEW
  EIGHTFOLD
  AVATURE
  TEAMTAILOR
  DIGITALRECRUITERS
  TALENTSOFT
  PHENOM
  SUCCESSFACTORS
  WTTJ
  ASHBY
  WORKABLE
  GREENHOUSE
  LEVER
  SMARTRECRUITERS
  RECRUITEE
  PERSONIO
  WORKDAY
  GENERIC_JSONLD
  WORDPRESS
  FASHIONJOBS
  ICIMS
  ORACLE_HCM
  TALEO
  ALTAMIRA
  JOBYLON
  RITUALS
  TALENT_FUNNEL
  BASH_TALENTS
  EQWA
  GEODIRECTORY
  TYPESENSE
  JIBE
  VOLCANIC
  SWATCH_GROUP
  UNKNOWN
}

/**
 * Lifecycle of a catalogue source (DEC-3, décision Loïc 2026-09-03).
 *
 * DRAFT      discovered/imported, identity or volume not yet proven
 * VALIDATED  proven (≥1 parsed offer, identity anchored) but not yet ingested
 * ACTIVE     in the ingest rotation
 * PAUSED     temporarily out (broken feed, throttling) — its rows stay in base
 * RETIRED    permanently out; `retire-source` has cleaned its rows
 */
enum SourceStatus {
  DRAFT
  VALIDATED
  ACTIVE
  PAUSED
  RETIRED
}

/**
 * The source catalogue, in base (DEC-3) — replaces data/sources.csv at runtime.
 *
 * A CSV had no lifecycle: removing a line left its offers orphaned forever
 * (the « Cartier +3 » incident), promotion was a hand edit, and nothing
 * recorded per-source quality. Here every source carries its status, its dated
 * robots verdict, its last run and its field-coverage rates as queryable
 * columns.
 */
model Source {
  id            String       @id @default(cuid())
  /** Stable key, referenced by JobSource.sourceKey and SourceRun.sourceKey. */
  key           String       @unique
  /** Displayed employer/board name ("Cartier", "Richemont (toutes Maisons)"). */
  maison        String
  careersDomain String?
  /** Adapter family: workday, greenhouse, generic-listing… */
  kind          String
  /**
   * Adapter config (origin, listingUrl, sitemapUrl…). For legacy sitemap rows
   * this is `{ "url": "<entry url>" }`.
   */
  config        Json
  /** Shape of a job URL for sitemap filtering, as observed. */
  jobUrlPattern String?
  status        SourceStatus @default(DRAFT)
  /** Dedup tier: EMPLOYER_DIRECT | GROUP_OFFICIAL | ATS_OFFICIAL | SPECIALIST_JOBBOARD | AGGREGATOR */
  tier          String
  /**
   * One row per ATS tenant (unicité par tenant): `kind:normalized-locator`.
   * Two Maisons resolving to the same board must arbitrate BEFORE import —
   * shared-tenant duplicates are how one group feed got catalogued twice.
   */
  tenantKey     String       @unique
  robotsVerdict String?
  /** When the robots verdict was last read at the source — a verdict ages. */
  robotsCheckedAt DateTime?
  /** Jobs counted when the source was last verified/promoted. */
  verifiedJobCount Int?
  /** Denormalized last-run summary, so the catalogue is readable in one query. */
  lastRunAt     DateTime?
  lastRunStatus String?
  lastRunJobs   Int?
  /** Last-run field-coverage rates, 0..1 (audit L-02 — queryable, not a note). */
  descriptionRate Float?
  dateRate      Float?
  countryRate   Float?
  urlRate       Float?
  note          String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([status])
  @@index([kind])
}

model Company {
  id                   String          @id @default(cuid())
  name                 String
  canonicalKey         String
  kind                 CompanyKind     @default(UNKNOWN)
  sector               CompanySector   @default(UNKNOWN)
  /**
   * Parent group, from the 728-house reference list: Sandro and Maje both sit
   * under SMCP, Dior under LVMH.
   *
   * Stored so a search for "sandro" reaches offers a group portal published
   * under "SMCP", and so the group is a filter of its own. The reference list
   * held this from the start and nothing was reading it.
   */
  parentGroup          String?
  /**
   * Site officiel de la Maison, hôte nu (`hermes.com`, `dior.com`), lu à une
   * source qui la NOMME — jamais deviné depuis le nom : un nom devine souvent
   * le domaine réel d'une AUTRE entreprise, et le logo affiché ment. Null =
   * inconnu, et le site montre l'initiale plutôt qu'un logo faux.
   */
  domain               String?
  /** D'où vient `domain` : `source-careers` (catalogue) | `wikidata` (P856) | `manual`. */
  domainSource         String?
  fashionjobsUrl       String          @unique
  fashionjobsSlug      String?
  fashionjobsOfferCount Int?
  careersUrl           String?
  atsType               AtsType         @default(UNKNOWN)
  atsConfig             Json?
  discoveryStatus       DiscoveryStatus @default(PENDING)
  discoveryNote         String?
  firstSeenAt           DateTime        @default(now())
  lastSeenAt            DateTime        @default(now())
  lastAtsDiscoveryAt    DateTime?
  lastJobSyncAt         DateTime?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt
  jobs                  Job[]
  aliases               CompanyAlias[]

  @@index([sector])
  @@index([canonicalKey])
  @@index([discoveryStatus])
  @@index([atsType])
}

model CompanyAlias {
  id          String   @id @default(cuid())
  aliasKey    String   @unique
  displayName String
  companyId   String
  company     Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdAt   DateTime @default(now())
}

/**
 * Where a canonical Job was seen. One row per (job, source).
 *
 * This is the whole point of the aggregator: the same opening reaches us from the
 * Maison's careers site, the group portal and a jobboard, and Catwalks keeps ONE
 * Job carrying N JobSource rows — never three listings.
 *
 * A lower-priority source stays attached even when it is not canonical: it is what
 * detects an edit or a closure when the canonical source is slow to update.
 */
model JobSource {
  id          String   @id @default(cuid())
  jobId       String
  job         Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** Registry key: 'richemont', 'wttj', 'fashionjobs'… */
  sourceKey   String
  /** EMPLOYER_DIRECT | GROUP_OFFICIAL | ATS_OFFICIAL | SPECIALIST_JOBBOARD | AGGREGATOR */
  sourceTier  String
  /** Identifier as this source knows it. */
  externalId  String
  /** Apply URL at THIS source; the canonical one lives on Job.url. */
  url         String
  title       String?
  postedAt    DateTime?
  firstSeenAt DateTime @default(now())
  lastSeenAt  DateTime @default(now())
  isActive    Boolean  @default(true)
  raw         Json?

  @@unique([sourceKey, externalId])
  @@index([jobId])
  @@index([sourceKey, isActive])
}

model Job {
  id            String   @id @default(cuid())
  companyId     String
  company       Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  externalId    String
  source        AtsType
  title         String
  location      String?
  country       String?
  isFrance      Boolean  @default(false)

  // Geo, for the Leaflet map. Sources give a city and usually a postcode but
  // never coordinates, so these are resolved via the French government's
  // Adresse API (api-adresse.data.gouv.fr — free, no key, 50 req/s/IP).
  city          String?
  /**
   * La première subdivision administrative du pays : California, Île-de-France,
   * Ontario, Tokyo. Modèle mondial validé le 2026-09-08.
   *
   * PAS de colonne `continent` : « Europe », « Asia Pacific » (le champ
   * `geographicArea` de certaines sources) sont des macro-régions BUSINESS,
   * dérivables du pays le jour où le besoin existe. Les mettre ici mélangerait
   * deux niveaux conceptuels.
   */
  adminArea1    String?
  /**
   * Le second niveau (comté, département). Nullable et VOLONTAIREMENT vide :
   * aucune source du catalogue ne le fournit aujourd'hui, et on ne remplit pas
   * artificiellement une colonne pour la justifier.
   */
  adminArea2    String?
  postalCode    String?
  /**
   * Code commune INSEE — identifiant national français, conservé parce qu'il
   * est une clé de jointure stable (contrairement à un nom de ville), mais qui
   * n'est PAS une primitive mondiale : 2 750 des 2 770 offres qui le portent
   * sont françaises. Les futurs identifiants nationaux le rejoindront dans une
   * structure `locationIdentifiers` plutôt qu'en ajoutant une colonne par pays.
   */
  inseeCode     String?
  latitude      Float?
  longitude     Float?

  /**
   * LES CINQ DIMENSIONS D'EMPLOI — mondiales, indépendantes et CUMULABLES.
   *
   * Elles remplacent `contract` + `workingTime`, qui mélangeaient quatre
   * concepts dans un champ unique et imposaient une grille juridique FRANÇAISE
   * (CDI/CDD/STAGE) à un catalogue mondial : un « Permanent » britannique n'est
   * pas un CDI, et un `CONTRACTOR` américain n'est pas un freelance.
   *
   * Deux mesures ont imposé la séparation (2026-09-08) :
   *  · `employment_type_code` sert « parttime_fixed_term » (225 offres) —
   *    DEUX dimensions dans une seule valeur, dont une était forcément écrasée ;
   *  · 2 359 offres Sephora sont « CDD » ET « Seasonal » : les deux sont vraies
   *    en même temps, donc `isSeasonal` ne peut pas être une valeur de durée.
   *
   * Règle : « le faible volume décide si on EXPOSE une dimension, pas si on
   * POLLUE la taxonomie canonique. » `engagementType` (0,3 % des offres) reste
   * une colonne nullable propre, sans index ni facette.
   *
   * « CDI » n'est plus une valeur : c'est le LIBELLÉ français de PERMANENT,
   * produit par la couche de localisation du site.
   */
  /** DURÉE : PERMANENT | FIXED_TERM | TEMPORARY. null = la source ne le dit pas. */
  employmentTerm String?
  /** RYTHME : FULL_TIME | PART_TIME. */
  workTime       String?
  /** DISPOSITIF : INTERNSHIP | APPRENTICESHIP | GRADUATE_PROGRAM | VIE. */
  programType    String?
  /**
   * NATURE JURIDIQUE : EMPLOYEE | FREELANCE | INDEPENDENT_CONTRACTOR.
   * `EMPLOYEE` exige une preuve positive — il n'est jamais déduit de l'absence
   * de freelance, ce qui reviendrait à inventer une donnée.
   */
  engagementType String?
  /**
   * Poste saisonnier — caractéristique INDÉPENDANTE de la durée : 2 414 offres
   * sont à la fois FIXED_TERM et saisonnières.
   */
  isSeasonal     Boolean?
  /**
   * Le MODE DE TRAVAIL, en taxonomie mondiale : ONSITE | HYBRID | REMOTE.
   * `null` = les sources ne le publient pas — jamais « sur site » par défaut.
   *
   * A remplacé `remote`, qui portait le vocabulaire PROPRIÉTAIRE de Welcome to
   * the Jungle (`punctual`, `fulltime`, `unknown`) directement dans le modèle
   * mondial, et stockait « unknown » comme une VALEUR sur 648 offres.
   *
   * ONSITE se définit comme « poste principalement rattaché au site, même si un
   * télétravail occasionnel est autorisé » — c'est pourquoi le `punctual` de
   * WTTJ (« télétravail ponctuel autorisé ») y tombe sans prétendre que le
   * télétravail est interdit. La valeur brute reste traçable dans `raw`.
   */
  workplaceType String?
  experienceYears Int?
  educationLevel  String?

  // Compensation, when the source publishes it (Pinpoint, WTTJ, TalentView,
  // Teamtailor). Stored as a band because that is how postings state it.
  salaryMin     Int?
  salaryMax     Int?
  salaryCurrency String?
  salaryPeriod  String?

  /** Function or department: "Retail", "Marketing"… */
  department    String?
  /** Expiry when published; drives the refresh pass. */
  validThrough  DateTime?

  description   String?
  /**
   * ISO-639-1 language of the posting text ("fr", "en", "de"…), declared by the
   * source when it says so, else detected from the text. Nothing filters on it
   * at ingest — every language is kept (decision, 2026-09-03); it exists for
   * display, filtering and translation on the jobboard side.
   */
  language      String?
  url           String
  postedAt      DateTime?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @default(now())
  isActive      Boolean  @default(true)
  /**
   * Cycle de vie (Catwalks Intelligence, D38) : quand le refresh a fermé
   * l'offre — effacé si une source la re-liste (ré-ouverture). Avec
   * `firstSeenAt`, c'est la durée de publication observée ; « durée de
   * publication » ≠ time-to-fill, la méthodologie le dit.
   */
  closedAt      DateTime?
  /** Nombre de ré-ouvertures : une offre qui revient plusieurs fois est un signal de repost. */
  reopenedCount Int      @default(0)

  /**
   * Taxonomie Intelligence, classée à l'ÉCRITURE depuis titre / département /
   * description (`normalize/taxonomy.ts`), re-classée à chaque ré-attestation
   * quand `taxonomyVersion` est en retard — l'auto-guérison, comme le pays et
   * la ville. Null = non classé (compté comme tel, jamais deviné).
   */
  /** Famille de métier du secteur : retail-client-advisor, atelier-craft, crm-clienteling… */
  jobFunction     String?
  /** INTERNSHIP | APPRENTICESHIP | GRADUATE | JUNIOR | MID | SENIOR | MANAGER | DIRECTOR | EXECUTIVE */
  seniority       String?
  /** Métier de boutique (conseil, direction de boutique, VM, opérations) — le Retail Hiring Index. */
  isRetail        Boolean?
  /** L'annonce parle d'IA / machine learning — l'AI Hiring Index. */
  isAiRelated     Boolean  @default(false)
  /** Compétences, outils, langues, concepts extraits du texte (dictionnaire canonique). */
  skills          String[] @default([])
  taxonomyVersion Int      @default(0)
  fingerprint   String

  /**
   * Generation of the pipeline that wrote this row.
   *
   * Rows written by an older pipeline cannot be repaired in place — offers
   * ingested before the adapters fetched descriptions have none to restore,
   * and sectors written before classification all read UNKNOWN. Each ingest
   * deletes rows below the current generation and refetches them from source,
   * so a schema-level fix ships as a version bump instead of a manual purge
   * someone must remember to run.
   */
  pipelineVersion Int    @default(0)

  /**
   * Blocking key of the dedup cluster: resolvedCompanyId|CITY.
   * Indexed because every write does a cluster lookup before inserting — that
   * lookup is what keeps duplicates out of the database in the first place,
   * rather than cleaning them up afterwards.
   */
  clusterKey    String?
  /** Tier of the source that owns Job.url, so a better source can take over. */
  canonicalTier String?

  sources       JobSource[]
  events        JobEvent[]

  raw           Json?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@unique([companyId, source, externalId])
  @@index([clusterKey])
  @@index([department])
  @@index([employmentTerm])
  @@index([workTime])
  @@index([isFrance, isActive])
  @@index([fingerprint])
  @@index([companyId, isActive])
  // Serves the map: only located, live French jobs are ever plotted.
  @@index([isFrance, isActive, latitude, longitude])
  // Intelligence : agrégats par pays / métier / séniorité, et les fenêtres J-7 / J-30.
  @@index([isActive, country])
  @@index([isActive, jobFunction])
  @@index([isActive, seniority])
  @@index([firstSeenAt])
  @@index([closedAt])
}

/**
 * Historique d'une offre (Catwalks Intelligence, D38) : chaque ouverture,
 * fermeture, ré-ouverture et changement de champ structurant (titre, ville,
 * pays, société, métier) est un événement daté. C'est ce qui permet, dans
 * trois ans, de rejouer le marché : la liste des offres se remplace, son
 * histoire ne se reconstruit pas.
 */
model JobEvent {
  id     String   @id @default(cuid())
  jobId  String
  job    Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  /** OPENED | CLOSED | REOPENED | CHANGED */
  type   String
  /** Pour CHANGED : le champ (title, city, country, companyId, jobFunction). */
  field  String?
  before String?
  after  String?
  at     DateTime @default(now())

  @@index([jobId, at])
  @@index([type, at])
}

/**
 * Photographie quotidienne du marché (Catwalks Intelligence, D38), une ligne
 * par (jour, périmètre, clé) : global, pays, ville, société, groupe, secteur,
 * métier, séniorité, contrat, et les croisements pays×métier / pays×secteur
 * qui servent la carte. Idempotente : recalculer un jour ré-écrit ses lignes.
 *
 * Les comparaisons J-7 / J-30 / M-12 lisent cette table, jamais Job — les
 * offres se ferment et se suppriment, la photographie reste.
 */
model MarketSnapshot {
  id                 String   @id @default(cuid())
  date               DateTime @db.Date
  /** global | country | city | company | group | sector | function | seniority | employmentTerm | country-function | country-sector */
  scope              String
  /** '' pour global ; ISO-2 ; 'FR|Paris' ; id de société ; nom de groupe ; clé de métier… */
  key                String
  activeJobs         Int
  /** Offres vues pour la première fois ce jour-là. */
  newJobs            Int
  /** Offres fermées ce jour-là. */
  closedJobs         Int
  hiringCompanies    Int
  /** Médiane des jours de publication des offres fermées ce jour-là (null si aucune). */
  medianLifespanDays Float?
  reopenedJobs       Int      @default(0)
  /**
   * `live` = photographié le jour même (vérité du moment, immuable : une
   * reconstruction ne l'écrase jamais) ; `reconstructed` = rejoué depuis
   * firstSeenAt/closedAt (approximation, audit I-2 : rejouer un jour depuis
   * l'état ACTUEL des offres ré-écrivait l'histoire).
   */
  mode               String   @default("live")
  createdAt          DateTime @default(now())

  @@unique([date, scope, key])
  @@index([scope, key, date])
  @@index([date, scope])
}

/**
 * Geocoding cache, keyed by the raw location string as a source wrote it.
 *
 * Cities repeat constantly across offers — Courir alone posts dozens of roles in
 * the same towns — so resolving per offer would waste tens of thousands of calls
 * on a handful of distinct places. `resolved = false` records a lookup that found
 * nothing, so a bad string is not retried on every run.
 */
model GeoCache {
  id          String   @id @default(cuid())
  /** Normalized lookup key (uppercase city, plus postcode when available). */
  queryKey    String   @unique
  city        String?
  postalCode  String?
  inseeCode   String?
  latitude    Float?
  longitude   Float?
  resolved    Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([resolved])
}

/**
 * One row per source per ingest run.
 *
 * Exists so a source that silently stops producing is an incident rather than a
 * quiet zero. Vendors rotate public keys and move listing paths without notice,
 * and the failure mode is always the same: the adapter returns an empty array,
 * the cron exits 0, and a Maison simply appears to have stopped hiring.
 */
model SourceRun {
  id           String   @id @default(cuid())
  sourceKey    String
  /** OK | DEGRADED | BROKEN | NEW | TIMEOUT | ERROR (L-01: unfinished runs are recorded too). */
  status       String
  jobs         Int
  /** What the source held before this run; null on its first. */
  previousJobs Int?
  note         String?
  /**
   * Field-coverage rates of this run, 0..1 (audit L-02): a source can keep its
   * volume while silently losing a field (the Eightfold descriptions). Columns,
   * not a note string, so trends are queryable.
   */
  descriptionRate Float?
  dateRate     Float?
  countryRate  Float?
  urlRate      Float?
  ranAt        DateTime @default(now())

  @@index([sourceKey, ranAt])
  @@index([status, ranAt])
}

/**
 * Where a rotating crawl should resume next run.
 *
 * A source too large and too slow to sweep inside one run (FashionJobs behind
 * Cloudflare, ~282 listing pages) advances through its listing across runs
 * instead of always re-reading the first pages: each run crawls a window from
 * `nextPage`, then stores where it stopped, wrapping back to page 1 at the end.
 * The cron fires several times a day, so a full rotation completes well within
 * the 48h lifecycle window — every offer is re-seen in time, and none is closed
 * as stale while it is still listed.
 */
model SourceCursor {
  sourceKey String   @id
  /** The listing page the next run should start from (1-based). */
  nextPage  Int      @default(1)
  updatedAt DateTime @updatedAt

  @@map("SourceCursor")
}

/**
 * La FIABILITÉ D'UNE PREUVE, mesurée puis jugée — `sourceFieldTrust` (2026-09-08).
 *
 * Née du constat qu'un champ « structuré » n'est pas automatiquement une source
 * de vérité : PVH déclarait `employmentType: FULL_TIME` sur 1 372 offres, dont
 * 485 dont le titre disait « Part-Time ».
 *
 * Le moteur est GÉNÉRIQUE : aucune source n'est nommée dans le code. Si demain
 * une autre source se comporte pareil, la même mesure la détecte sans qu'on
 * ajoute une règle. PVH n'est qu'une observation parmi d'autres.
 *
 * Le grain est `source × chemin × dimension`, jamais la source seule : un champ
 * peut être faux pour le rythme sans rien dire de sa fiabilité ailleurs.
 */
model SourceFieldTrust {
  id             String   @id @default(cuid())
  /** Clé du catalogue (`pvh`, `fashionjobs`…). */
  source         String
  /** Chemin dans le payload (`employmentType`, `tags1[0]`) — pas la valeur. */
  path           String
  /** Dimension jugée : employmentTerm | workTime | programType | engagementType. */
  dimension      String

  /** TRUSTED | DEGRADED | UNTRUSTED | INSUFFICIENT_EVIDENCE. */
  level          String
  /** Offres où les DEUX preuves se prononcent — le dénominateur, pas le total. */
  eligibleCount  Int
  agreementCount Int
  contradictionCount Int
  contradictionRate  Float
  /** La phrase qui explique le verdict, lisible sans relire le code. */
  reason         String
  /** Quelle logique a produit ce verdict — pour pouvoir rejouer. */
  evaluatorVersion String
  /** Dernière offre observée pour ce triplet : un verdict doit pouvoir vieillir. */
  observedAt     DateTime
  evaluatedAt    DateTime @default(now())

  history        SourceFieldTrustObservation[]

  @@unique([source, path, dimension])
  @@index([level])
}

/**
 * L'HISTORIQUE des observations — il n'expire JAMAIS.
 *
 * Le verdict opérationnel peut retomber à INSUFFICIENT_EVIDENCE après 60 jours
 * de silence (une source peut réparer son flux), mais la mémoire de son
 * comportement passé reste : c'est ce qui permet d'expliquer une dégradation
 * ancienne et de détecter une RÉCIDIVE. Décision Loïc : « le verdict
 * opérationnel peut expirer ; l'observation historique, non. »
 */
model SourceFieldTrustObservation {
  id             String   @id @default(cuid())
  trustId        String
  trust          SourceFieldTrust @relation(fields: [trustId], references: [id], onDelete: Cascade)
  level          String
  eligibleCount  Int
  contradictionCount Int
  contradictionRate  Float
  evaluatorVersion String
  observedAt     DateTime
  recordedAt     DateTime @default(now())

  @@index([trustId, recordedAt])
}
