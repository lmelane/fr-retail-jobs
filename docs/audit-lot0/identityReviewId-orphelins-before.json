{
  "objet": "Etat AVANT neutralisation des references identityReviewId orphelines",
  "avertissement": "Trace d'audit du nettoyage. NE RECONSTITUE PAS les EmployerIdentityReview disparues.",
  "date": "2026-09-22",
  "commit": "78a5a6b3f8a5c39d9cf64d889e1fc97870496e60",
  "base": "production (railway), lecture seule via catwalks_audit",
  "requete": "SELECT c.id, c.name, c.\"identityReviewId\", c.\"mergedIntoId\",\n       (SELECT count(*) FROM \"Job\" j WHERE j.\"companyId\" = c.id) AS jobs,\n       (SELECT count(*) FROM \"Job\" j WHERE j.\"companyId\" = c.id AND j.\"isActive\" AND j.\"mergedIntoId\" IS NULL) AS jobs_actifs\n  FROM \"Company\" c\n WHERE c.\"identityReviewId\" IS NOT NULL\n   AND NOT EXISTS (SELECT 1 FROM \"EmployerIdentityReview\" r WHERE r.id = c.\"identityReviewId\")\n ORDER BY c.name",
