{
  "name": "fr-retail-jobs",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "db:generate": "npm run db:generate -w @catwalks/db",
    "db:push": "npm run db:push -w @catwalks/db",
    "ingest": "npm run ingest -w @catwalks/aggregator",
    "refresh": "npm run refresh -w @catwalks/aggregator",
    "reconcile": "npm run reconcile -w @catwalks/aggregator",
    "web:dev": "npm run dev -w @catwalks/web",
    "web:build": "npm run build -w @catwalks/web",
    "typecheck": "npm run typecheck -w @catwalks/aggregator && npm run typecheck -w @catwalks/web"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true
  }
}
