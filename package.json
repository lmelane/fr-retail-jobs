{
  "name": "fr-retail-jobs",
  "private": true,
  "version": "0.1.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "test:local": "node apps/aggregator/scripts/validate-local.mjs",
    "db:generate": "npm run db:generate -w @catwalks/db",
    "db:push": "npm run db:push -w @catwalks/db",
    "ingest": "npm run ingest -w @catwalks/aggregator",
    "refresh": "npm run refresh -w @catwalks/aggregator",
    "api:dev": "npm run dev -w @catwalks/api",
    "api:build": "npm run build -w @catwalks/api",
    "typecheck": "npm run typecheck -w @catwalks/aggregator && npm run typecheck -w @catwalks/api",
    "stack": "node apps/aggregator/scripts/stack-local/index.mjs",
    "stack:prepare": "node apps/aggregator/scripts/stack-local/index.mjs prepare",
    "stack:start": "node apps/aggregator/scripts/stack-local/index.mjs start",
    "stack:verify": "node apps/aggregator/scripts/stack-local/index.mjs verify",
    "stack:stop": "node apps/aggregator/scripts/stack-local/index.mjs stop",
    "stack:reset": "node apps/aggregator/scripts/stack-local/index.mjs reset",
    "stack:status": "node apps/aggregator/scripts/stack-local/index.mjs status",
    "stack:sync": "node apps/aggregator/scripts/stack-local/index.mjs sync",
    "stack:exec": "node apps/aggregator/scripts/stack-local/index.mjs exec"
  },
  "allowScripts": {
    "prisma@6.19.3": true,
    "@prisma/engines@6.19.3": true,
    "@prisma/client@6.19.3": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "postcss": "8.5.28",
    "deepmerge-ts": "8.0.0"
  }
}
