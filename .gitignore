node_modules/
dist/
build/

# Secrets — never commit. .env.example documents the shape instead.
.env
.env.*
!.env.example

# Local Claude Code state
.claude/

# Scratch data and one-off probes
# Scratch CSV exports, but NOT the reference list: data/maisons.csv is the
# 713-house source of truth the sector filter reads at runtime.
*.csv
!apps/aggregator/data/*.csv
# Discovery output lives one level deeper; the negation above stops at data/,
# so it needs its own. These CSVs are hours of agent work and were briefly
# living only in /tmp, which the OS clears on reboot.
!apps/aggregator/data/discovery/*.csv
*.html
*.xml
# …mais jamais les ROUTES Next nommées sitemap.xml (leçon : la route index a
# été silencieusement exclue — 404 en prod pendant que le local marchait)
!apps/web/app/sitemap.xml/
!apps/web/app/sitemap.xml/**
*-test.ts
probe-*.ts
scratchpad/

