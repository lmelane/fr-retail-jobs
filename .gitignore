node_modules/
dist/
build/

# Secrets — never commit. .env.example documents the shape instead.
.env
.env.*
!.env.example

# Local Claude Code state
.claude/

# Generated exports stay private; curated application data is versioned below.
*.csv
*.html
*.xml
# …mais jamais un dossier de ROUTE Next nommé *.xml (leçon : une route index
# sitemap.xml a été silencieusement exclue — 404 en prod pendant que le local
# marchait). L'API n'en a plus ; la règle protège la prochaine.
!apps/api/app/**/*.xml/
!apps/api/app/**/*.xml/**
*-test.ts
probe-*.ts
scratchpad/

# Logs and OS noise
*.log
npm-debug.log*
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp

# Next.js
.next/
.next-*/
next-env.d.ts
*.tsbuildinfo

# Artefacts de tests (Playwright, vitest) : jamais versionnés
playwright-report/
test-results/

# Artefacts locaux de session (jamais dans le dépôt)
backups/
*.woff2
*.xlsx
*.tgz
prod.css
design_2.md
catwalks-build.code-workspace
mode careers.svg
fashion-atlas.svg
fashionatlas.svg
index_1.html
Capture*.png

# Curated nested application references and explicit import seeds.
!apps/aggregator/data/**/*.csv

# Immutable historical exports moved out of the application.
!audits/legacy-aggregator-data/**/*.csv
!audits/legacy-aggregator-data/*.csv
!audits/legacy-aggregator-data/**/*.html
!audits/legacy-aggregator-data/**/*.xml
__pycache__/

# Stack locale : configuration privée, secrets de test, PID, journaux, boîte de réception, preuves.
.stack-local/

# Corpus de référence : manifestes d'instantané produits par `corpus-reference.mts`.
# Ils portent la répartition par source et par employeur de tout le catalogue — de la donnée
# métier, pas du code. Le SCRIPT est versionné (il est la façon de les rejouer), sa SORTIE non.
.corpus/
.corpus-*/
