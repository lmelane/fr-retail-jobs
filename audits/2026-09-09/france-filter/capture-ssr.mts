import{load}from'cheerio';import{writeFileSync}from'node:fs';import{createHash}from'node:crypto';
const url='https://modecareers.com/emplois?pays=FR';const r=await fetch(url,{signal:AbortSignal.timeout(45000)});const html=await r.text();const $=load(html);$('script,style').remove();const body=$('body').text().replace(/\s+/g,' ').trim();const matches=[...body.matchAll(/.{0,100}(?:10[\s ,]?936|offres? en France|France \().{0,100}/g)].map(m=>m[0]);console.log(JSON.stringify({status:r.status,matches}));writeFileSync('audits/2026-09-09/france-filter/ssr-proof.json',JSON.stringify({at:new Date().toISOString(),url,status:r.status,sha256:createHash('sha256').update(html).digest('hex'),visibleTextExcerpts:matches},null,2)+'\n');
