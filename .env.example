DATABASE_URL="postgresql://user:password@host:5432/catwalks?sslmode=require"

# REQUIRED for `discover-ats`: without it the command fails fast instead of
# marking every company NEEDS_REVIEW.
SERPER_API_KEY=""

# Discovery/sync tuning
HTTP_TIMEOUT_MS=20000
HTTP_CONCURRENCY=5
ATS_DISCOVERY_CONCURRENCY=3
SYNC_CONCURRENCY=4
USER_AGENT="CatwalksJobsBot/0.1 (+https://catwalks.io)"

# Browser transport (FashionJobs only — it is Cloudflare-protected).
BROWSER_TIMEOUT_MS=45000
BROWSER_SETTLE_MS=4000
# Directory safety net: observed 668 companies on 2026-09-01.
FASHIONJOBS_MIN_COMPANIES=400
