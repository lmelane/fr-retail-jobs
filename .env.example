DATABASE_URL="postgresql://user:password@host:5432/catwalks?sslmode=require"

# Local worker only: explicitly set 0 for an intentional manual collection.
# Railway variables are rendered from docs/operations/railway/runtime-target.json.
PIPELINE_PAUSED=1
# Existing Healthchecks ping URL (secret). No management API key is needed.
HEALTHCHECK_PING_URL=""

# Offres directes (D-423) — `tsx src/cli.ts direct-sync` in apps/aggregator reads the
# Catwalks backend outbox feed. Both are REQUIRED for that command; nothing else reads them.
CATALOGUE_FLUX_URL="https://backend.example"
CATALOGUE_FLUX_KEY=""

# API du catalogue (D-422) — clé partagée avec le seul appelant, le rendu serveur de
# catwalks.io (`Authorization: Bearer …`). En production, une clé ABSENTE ferme l'API
# (503 « non configuré ») ; hors production son absence est tolérée et journalisée.
CATALOGUE_API_KEY=""


# Local HTTP timeout. Railway uses the versioned runtime contract.
HTTP_TIMEOUT_MS=20000

# Browser transport (FashionJobs only — it is Cloudflare-protected).
BROWSER_TIMEOUT_MS=45000
BROWSER_SETTLE_MS=4000
# Directory safety net: observed 668 companies on 2026-09-01.
FASHIONJOBS_MIN_COMPANIES=400
