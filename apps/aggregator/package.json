{
  "name": "@catwalks/aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "tsx src/cli.ts ingest",
    "ingest-all": "tsx src/cli.ts ingest-all",
    "refresh": "tsx src/cli.ts refresh",
    "reconcile": "tsx src/cli.ts reconcile",
    "geocode": "tsx src/cli.ts geocode",
    "import-sources": "tsx src/cli.ts import-sources",
    "stats": "tsx src/cli.ts stats",
    "health:report": "tsx src/cli.ts health-report",
    "export:companies": "tsx src/cli.ts export-companies",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run --exclude 'src/pipeline/**' --exclude 'src/dedup/**'",
    "test:integration": "vitest run src/pipeline src/dedup",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@catwalks/db": "*",
    "@prisma/client": "^6.15.0",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.2.5",
    "p-limit": "^7.1.1",
    "playwright": "1.62.1",
    "tldts": "^7.4.11",
    "tough-cookie": "6.0.2",
    "undici": "^7.29.0"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "3.2.6"
  }
}
