{
  "name": "@catwalks/aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "ingest": "tsx src/cli.ts ingest",
    "ingest-all": "tsx src/cli.ts ingest-all",
    "refresh": "tsx src/cli.ts refresh",
    "reconcile": "tsx src/cli.ts reconcile",
    "geocode": "tsx src/cli.ts geocode",
    "stats": "tsx src/cli.ts stats",
    "export:companies": "tsx src/cli.ts export-companies",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run src/normalize src/lib/france.test.ts src/lib/html.test.ts src/lib/ssrf.test.ts src/geo",
    "test:integration": "vitest run src/pipeline",
    "test": "npm run test:unit && npm run test:integration"
  },
  "dependencies": {
    "@catwalks/db": "*",
    "@prisma/client": "^6.15.0",
    "cheerio": "^1.1.2",
    "fast-xml-parser": "^5.2.5",
    "p-limit": "^7.1.1",
    "playwright": "1.62.1"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vitest": "^2.1.9"
  }
}
